-                if (st->codecpar->extradata && st->codecpar->extradata_size >= 19) {
-                    if (st->codecpar->extradata[18] == 0 && ch <= 2) {
+                if (ts_st->extradata && ts_st->extradata_size >= 19) {
+                    if (ts_st->extradata[18] == 0 && ch <= 2) {
