         if (st->id < 16) {
@@ -1244,7 +1253,7 @@ static int mpegts_init(AVFormatContext *s)
         ts_st->cc              = 15;
         ts_st->discontinuity   = ts->flags & MPEGTS_FLAG_DISCONT;
         if (st->codecpar->codec_id == AV_CODEC_ID_AAC &&
-            st->codecpar->extradata_size > 0) {
+            ts_st->extradata_size > 0) {
             AVStream *ast;
             ts_st->amux = avformat_alloc_context();
             if (!ts_st->amux) {
@@ -1904,12 +1913,12 @@ static int mpegts_write_packet_internal(AVFormatContext *s, AVPacket *pkt)
         const uint8_t *found_aud = NULL, *found_aud_end = NULL;
         int nal_type;
         uint32_t state = -1;
-        int extradd = (pkt->flags & AV_PKT_FLAG_KEY) ? st->codecpar->extradata_size : 0;
+        int extradd = (pkt->flags & AV_PKT_FLAG_KEY) ? ts_st->extradata_size : 0;
         int ret = ff_check_h264_startcode(s, st, pkt);
         if (ret < 0)
             return ret;
 
-        if (extradd && AV_RB24(st->codecpar->extradata) > 1)
+        if (extradd && AV_RB24(ts_st->extradata) > 1)
             extradd = 0;

         /* Ensure that all pictures are prefixed with an AUD, and that
@@ -1957,7 +1966,7 @@ static int mpegts_write_packet_internal(AVFormatContext *s, AVPacket *pkt)
             bytestream2_init_writer(&pb, data, new_pkt_size);
             bytestream2_put_byte(&pb, 0x00);
             bytestream2_put_buffer(&pb, found_aud, found_aud_end - found_aud);
-            bytestream2_put_buffer(&pb, st->codecpar->extradata, extradd);
+            bytestream2_put_buffer(&pb, ts_st->extradata, extradd);
             bytestream2_put_buffer(&pb, pkt->data, found_aud - pkt->data);
             bytestream2_put_buffer(&pb, found_aud_end, buf_end - found_aud_end);
             av_assert0(new_pkt_size == bytestream2_tell_p(&pb));
@@ -2001,12 +2010,12 @@ static int mpegts_write_packet_internal(AVFormatContext *s, AVPacket *pkt)
         const uint8_t *p = buf, *buf_end = p + size;
         uint32_t state = -1;
         int nal_type;
-        int extradd = (pkt->flags & AV_PKT_FLAG_KEY) ? st->codecpar->extradata_size : 0;
+        int extradd = (pkt->flags & AV_PKT_FLAG_KEY) ? ts_st->extradata_size : 0;
         int ret = check_h26x_startcode(s, st, pkt, "hevc");
         if (ret < 0)
             return ret;
 
-        if (extradd && AV_RB24(st->codecpar->extradata) > 1)
+        if (extradd && AV_RB24(ts_st->extradata) > 1)
             extradd = 0;
 
         do {
@@ -2288,6 +2297,7 @@ static void mpegts_deinit(AVFormatContext *s)
         if (ts_st) {
             av_freep(&ts_st->dvb_ac3_desc);
             av_freep(&ts_st->payload);
+            av_freep(&ts_st->extradata);
             if (ts_st->amux) {
                 avformat_free_context(ts_st->amux);
                 ts_st->amux = NULL;

From 5c4cdb320bd6e7e01dee18570340a3d73b4c8040 Mon Sep 17 00:00:00 2001
From: James Almer <jamrial@gmail.com>
Date: Mon, 19 Sep 2022 09:19:45 -0300
Subject: [PATCH 2/4] avformat/mpegtsenc: look for extradata updates in input
 packets

This ensures the correct information is written in PES packets in case extradata
changes mid stream, or if extradata is not available at init().

Signed-off-by: James Almer <jamrial@gmail.com>
---
 libavformat/mpegtsenc.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/libavformat/mpegtsenc.c b/libavformat/mpegtsenc.c
index 010502b2bfb0b..596ed4bdc759d 100644
--- a/libavformat/mpegtsenc.c
+++ b/libavformat/mpegtsenc.c
@@ -1890,6 +1890,15 @@ static int mpegts_write_packet_internal(AVFormatContext *s, AVPacket *pkt)
     if (side_data)
         stream_id = side_data[0];
 
+    side_data = av_packet_get_side_data(pkt,
+                                        AV_PKT_DATA_NEW_EXTRADATA,
+                                        &side_data_size);
+    if (side_data) {
+        av_free(ts_st->extradata);
+        ts_st->extradata = av_memdup(side_data, side_data_size);
+        ts_st->extradata_size = side_data_size;
+    }
+
     if (!ts->first_dts_checked && dts != AV_NOPTS_VALUE) {
         ts->first_pcr += dts * SYSTEM_CLOCK_FREQUENCY_DIVISOR;
         ts->first_dts_checked = 1;

From 3693e78e942ba8d0edff921285420cd5d23e2f99 Mon Sep 17 00:00:00 2001
From: James Almer <jamrial@gmail.com>
